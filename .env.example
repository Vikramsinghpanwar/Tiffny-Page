# All optional. Read at BUILD time (static export) — set them in Cloudflare Pages
# → Settings → Variables and secrets for the Production environment, then redeploy.

# Where this landing site is served. Used for canonical URLs, sitemap.xml,
# robots.txt and Open Graph tags. Default: https://www.tiffny.online
# NEXT_PUBLIC_SITE_URL=https://www.tiffny.online

# The Tiffny web app. Login / Get Started / Join as a Vendor link here.
# Default: https://tiffny.online
# NEXT_PUBLIC_APP_URL=https://tiffny.online

# Public contact email. When unset, no contact details are shown anywhere.
# NEXT_PUBLIC_CONTACT_EMAIL=
